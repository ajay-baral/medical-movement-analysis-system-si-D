{
  "name": "medical-movement-analysis-system",
  "private": true,
  "version": "0.1.0",
  "description": "Monorepo for Medical Movement Analysis System",
  "workspaces": [
    "apps/mobile"
  ],
  "scripts": {
    "mobile:start": "./scripts/start-mobile.sh",
    "mobile:start:tunnel": "./scripts/start-mobile.sh --tunnel",
    "lint": "npm run -w apps/mobile lint",
    "format:check": "npm run -w apps/mobile format:check",
    "typecheck": "npm run -w apps/mobile typecheck",
    "test": "npm run -w apps/mobile test && PYTHONPATH=services/backend services/backend/venv/bin/pytest services/backend/tests -q"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {},
  "overrides": {
    "react-native-worklets": "0.5.1",
    "@types/react": "~18.3.12"
  }
}
